# استخدم إصدار Node.js الخفيف (Alpine) لتقليل حجم الحاوية
FROM node:20-alpine

# تحديد مجلد العمل داخل الحاوية
WORKDIR /app

# نسخ ملفات تعريف الحزم أولاً (للاستفادة من الكاش وتسريع عملية البناء)
COPY package.json package-lock.json* ./

# تثبيت الحزم (التبعيات)
RUN npm install

# نسخ باقي ملفات المشروع إلى داخل الحاوية
COPY . .

# بناء المشروع (Client + Server)
RUN npm run build

# تعيين منفذ التطبيق (افتراضياً 5002 كما هو في ملف .env الخاص بك)
EXPOSE 5002

# تشغيل التطبيق (نتخطى استخدام --env-file من السكربت لتجنب الأخطاء إذا لم يكن الملف موجوداً، ويفضل تمرير المتغيرات عبر Docker)
CMD ["node", "dist/index.js"]
